# Copy to .env and fill in. Never commit .env.

# https://dev.twitch.tv/console/apps → Register Your Application → Client ID + New Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# https://app.postforme.dev → API keys
POST_FOR_ME_API_KEY=
